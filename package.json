{
  "name": "apexline-karting",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Apexline Kart Circuit – static HTML / Tailwind CSS v4 / vanilla JS website",
  "scripts": {
    "dev": "tailwindcss -i ./src/css/main.css -o ./dist/styles.css --watch",
    "build": "node scripts/build-pages.mjs && tailwindcss -i ./src/css/main.css -o ./dist/styles.css --minify",
    "serve": "node scripts/serve.mjs",
    "check": "node scripts/check-contrast.mjs",
    "images": "node scripts/fetch-images.mjs",
    "audit:contrast": "node scripts/audit-rendered-contrast.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/big-shoulders-display": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@tailwindcss/cli": "^4.3.5",
    "tailwindcss": "^4.3.5"
  }
}
